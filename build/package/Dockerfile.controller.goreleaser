FROM alpine@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6
RUN apk add --no-cache ca-certificates && \
    addgroup -S draforge && adduser -S draforge -G draforge
USER draforge
WORKDIR /home/draforge
ARG TARGETPLATFORM
COPY $TARGETPLATFORM/draforge-controller ./
ENTRYPOINT ["./draforge-controller"]
