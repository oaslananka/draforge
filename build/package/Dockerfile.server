# Multi-stage Dockerfile for draforge-server
# Stage 1: Build React Frontend Dashboard
# node:22.23.1-alpine
ARG NODE_IMAGE=node@sha256:16e22a550f3863206a3f701448c45f7912c6896a62de43add43bb9c86130c3e2
FROM ${NODE_IMAGE} AS frontend-builder
WORKDIR /web
RUN npm install --global --ignore-scripts --force corepack@0.35.0 && \
    corepack enable && \
    corepack prepare pnpm@11.5.2 --activate
COPY web/package.json web/pnpm-lock.yaml web/pnpm-workspace.yaml ./
COPY web/vendor ./vendor
COPY web/patches ./patches
RUN pnpm install --frozen-lockfile --ignore-scripts
COPY web/ ./
RUN pnpm build

# Stage 2: Build Go API Server
FROM golang:1.26.5 AS backend-builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG VERSION=dev
ARG COMMIT=unknown
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s -X main.versionVal=${VERSION} -X main.commitSHA=${COMMIT}" -o draforge ./cmd/draforge

# Stage 3: Runner
FROM alpine:3.20.0
RUN apk add --no-cache ca-certificates && \
    addgroup -S draforge && adduser -S draforge -G draforge
USER draforge
WORKDIR /home/draforge
COPY --from=backend-builder /app/draforge .
COPY --from=frontend-builder /web/dist ./web/dist
EXPOSE 8080
ENTRYPOINT ["./draforge", "serve"]
