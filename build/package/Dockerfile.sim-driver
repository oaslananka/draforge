# Dockerfile for draforge-sim-driver
# Stage 1: Build Go Driver
FROM golang@sha256:0d1d3a794be25f809dd2cb3160d8c73276c4056a9f8242a138e908ddeee7b6b6 AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG VERSION=dev
ARG COMMIT=unknown
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s -X main.versionVal=${VERSION} -X main.commitSHA=${COMMIT}" -o draforge-sim-driver ./cmd/draforge-sim-driver

# Stage 2: Runner
FROM alpine@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6
RUN apk add --no-cache ca-certificates && \
    addgroup -S draforge && adduser -S draforge -G draforge
USER draforge
WORKDIR /home/draforge
COPY --from=builder /app/draforge-sim-driver .
ENTRYPOINT ["./draforge-sim-driver"]
