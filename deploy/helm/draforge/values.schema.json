{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "definitions": {
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9_][A-Za-z0-9._-]{0,127})?$"
        },
        "digest": {
          "type": "string",
          "pattern": "^(?:sha256:[a-f0-9]{64})?$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "required": [
        "repository",
        "tag",
        "digest",
        "pullPolicy"
      ]
    },
    "lifecycle": {
      "type": "object",
      "properties": {
        "readinessTimeout": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(ms|s|m|h)$"
        },
        "readinessGracePeriod": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]*(ms|s|m|h))$"
        },
        "shutdownTimeout": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(ms|s|m|h)$"
        }
      },
      "required": [
        "readinessTimeout",
        "readinessGracePeriod",
        "shutdownTimeout"
      ],
      "additionalProperties": false
    }
  },
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "imageRegistry": {
          "type": "string",
          "minLength": 1
        },
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "name"
            ]
          }
        }
      },
      "required": [
        "imageRegistry",
        "imagePullSecrets"
      ]
    },
    "nodePlugin": {
      "type": "object",
      "properties": {
        "outputMode": {
          "type": "string",
          "enum": [
            "demo",
            "node"
          ],
          "default": "demo"
        },
        "image": {
          "$ref": "#/definitions/image"
        }
      },
      "required": [
        "outputMode",
        "image"
      ]
    },
    "server": {
      "type": "object",
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "image": {
          "$ref": "#/definitions/image"
        },
        "lifecycle": {
          "$ref": "#/definitions/lifecycle"
        }
      },
      "required": [
        "replicaCount",
        "image",
        "lifecycle"
      ]
    },
    "controller": {
      "type": "object",
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "image": {
          "$ref": "#/definitions/image"
        },
        "metrics": {
          "type": "object",
          "properties": {
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "service": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "ClusterIP"
                  ]
                },
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              },
              "required": [
                "enabled",
                "type",
                "port"
              ]
            },
            "networkPolicy": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "namespaceSelector": {
                  "type": "object",
                  "properties": {
                    "matchLabels": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string"
                      }
                    }
                  },
                  "additionalProperties": false
                },
                "podSelector": {
                  "type": "object",
                  "properties": {
                    "matchLabels": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string"
                      }
                    }
                  },
                  "additionalProperties": false
                }
              },
              "required": [
                "enabled",
                "namespaceSelector",
                "podSelector"
              ]
            },
            "serviceMonitor": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "namespace": {
                  "type": "string",
                  "maxLength": 63,
                  "pattern": "^(?:[a-z0-9](?:[-a-z0-9]*[a-z0-9])?)?$"
                },
                "labels": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "interval": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*(ms|s|m|h)$"
                },
                "scrapeTimeout": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*(ms|s|m|h)$"
                }
              },
              "required": [
                "enabled",
                "namespace",
                "labels",
                "interval",
                "scrapeTimeout"
              ]
            }
          },
          "required": [
            "port",
            "service",
            "networkPolicy",
            "serviceMonitor"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "networkPolicy": {
                    "properties": {
                      "enabled": {
                        "const": true
                      }
                    },
                    "required": [
                      "enabled"
                    ]
                  }
                }
              },
              "then": {
                "properties": {
                  "networkPolicy": {
                    "properties": {
                      "namespaceSelector": {
                        "properties": {
                          "matchLabels": {
                            "minProperties": 1
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "serviceMonitor": {
                    "properties": {
                      "enabled": {
                        "const": true
                      }
                    },
                    "required": [
                      "enabled"
                    ]
                  }
                }
              },
              "then": {
                "properties": {
                  "service": {
                    "properties": {
                      "enabled": {
                        "const": true
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        "lifecycle": {
          "$ref": "#/definitions/lifecycle"
        }
      },
      "required": [
        "replicaCount",
        "image",
        "metrics",
        "lifecycle"
      ]
    },
    "networkPolicies": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "allowAllEgress": {
          "type": "boolean"
        }
      }
    }
  },
  "required": [
    "global",
    "server",
    "controller",
    "nodePlugin"
  ]
}
