{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "definitions": {
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9_][A-Za-z0-9._-]{0,127})?$"
        },
        "digest": {
          "type": "string",
          "pattern": "^(?:sha256:[a-f0-9]{64})?$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "required": [
        "repository",
        "tag",
        "digest",
        "pullPolicy"
      ]
    },
    "lifecycle": {
      "type": "object",
      "properties": {
        "readinessTimeout": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(ms|s|m|h)$"
        },
        "readinessGracePeriod": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]*(ms|s|m|h))$"
        },
        "shutdownTimeout": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(ms|s|m|h)$"
        }
      },
      "required": [
        "readinessTimeout",
        "readinessGracePeriod",
        "shutdownTimeout"
      ],
      "additionalProperties": false
    }
  },
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "imageRegistry": {
          "type": "string",
          "minLength": 1
        },
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "name"
            ]
          }
        }
      },
      "required": [
        "imageRegistry",
        "imagePullSecrets"
      ]
    },
    "nodePlugin": {
      "type": "object",
      "properties": {
        "outputMode": {
          "type": "string",
          "enum": [
            "demo",
            "node"
          ],
          "default": "demo"
        },
        "image": {
          "$ref": "#/definitions/image"
        }
      },
      "required": [
        "outputMode",
        "image"
      ]
    },
    "server": {
      "type": "object",
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "image": {
          "$ref": "#/definitions/image"
        },
        "lifecycle": {
          "$ref": "#/definitions/lifecycle"
        },
        "cors": {
          "type": "object",
          "properties": {
            "allowedOrigins": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "allowedOrigins"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "replicaCount",
        "image",
        "lifecycle",
        "cors"
      ]
    },
    "controller": {
      "type": "object",
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "image": {
          "$ref": "#/definitions/image"
        },
        "metrics": {
          "type": "object",
          "properties": {
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "service": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "ClusterIP"
                  ]
                },
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              },
              "required": [
                "enabled",
                "type",
                "port"
              ]
            },
            "networkPolicy": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "namespaceSelector": {
                  "type": "object",
                  "properties": {
                    "matchLabels": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string"
                      }
                    }
                  },
                  "additionalProperties": false
                },
                "podSelector": {
                  "type": "object",
                  "properties": {
                    "matchLabels": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string"
                      }
                    }
                  },
                  "additionalProperties": false
                }
              },
              "required": [
                "enabled",
                "namespaceSelector",
                "podSelector"
              ]
            },
            "serviceMonitor": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "namespace": {
                  "type": "string",
                  "maxLength": 63,
                  "pattern": "^(?:[a-z0-9](?:[-a-z0-9]*[a-z0-9])?)?$"
                },
                "labels": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "interval": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*(ms|s|m|h)$"
                },
                "scrapeTimeout": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*(ms|s|m|h)$"
                }
              },
              "required": [
                "enabled",
                "namespace",
                "labels",
                "interval",
                "scrapeTimeout"
              ]
            }
          },
          "required": [
            "port",
            "service",
            "networkPolicy",
            "serviceMonitor"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "networkPolicy": {
                    "properties": {
                      "enabled": {
                        "const": true
                      }
                    },
                    "required": [
                      "enabled"
                    ]
                  }
                }
              },
              "then": {
                "properties": {
                  "networkPolicy": {
                    "properties": {
                      "namespaceSelector": {
                        "properties": {
                          "matchLabels": {
                            "minProperties": 1
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "serviceMonitor": {
                    "properties": {
                      "enabled": {
                        "const": true
                      }
                    },
                    "required": [
                      "enabled"
                    ]
                  }
                }
              },
              "then": {
                "properties": {
                  "service": {
                    "properties": {
                      "enabled": {
                        "const": true
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        "lifecycle": {
          "$ref": "#/definitions/lifecycle"
        }
      },
      "required": [
        "replicaCount",
        "image",
        "metrics",
        "lifecycle"
      ]
    },
    "networkPolicies": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "allowAllEgress": {
          "type": "boolean"
        }
      }
    },
    "gateway": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "allowInsecureHTTP": {
          "type": "boolean"
        },
        "className": {
          "type": "string",
          "minLength": 1
        },
        "hostname": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^(?:[a-z0-9](?:[-a-z0-9]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[-a-z0-9]{0,61}[a-z0-9])?)*)?$"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tls": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "secretName": {
              "type": "string",
              "maxLength": 253,
              "pattern": "^(?:[a-z0-9](?:[-a-z0-9]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[-a-z0-9]{0,61}[a-z0-9])?)*)?$"
            }
          },
          "required": [
            "enabled",
            "secretName"
          ],
          "additionalProperties": false
        },
        "authentication": {
          "type": "object",
          "properties": {
            "proxyService": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 63,
                  "pattern": "^(?:[a-z0-9](?:[-a-z0-9]*[a-z0-9])?)?$"
                },
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              },
              "required": [
                "name",
                "port"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "proxyService"
          ],
          "additionalProperties": false
        },
        "ingress": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "className": {
              "type": "string",
              "minLength": 1
            },
            "annotations": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "required": [
            "enabled",
            "className",
            "annotations"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "enabled",
        "allowInsecureHTTP",
        "className",
        "hostname",
        "annotations",
        "tls",
        "authentication",
        "ingress"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "global",
    "server",
    "controller",
    "nodePlugin",
    "gateway"
  ],
  "allOf": [
    {
      "not": {
        "properties": {
          "gateway": {
            "properties": {
              "enabled": {
                "const": true
              },
              "ingress": {
                "properties": {
                  "enabled": {
                    "const": true
                  }
                },
                "required": [
                  "enabled"
                ]
              }
            },
            "required": [
              "enabled",
              "ingress"
            ]
          }
        }
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "properties": {
              "gateway": {
                "properties": {
                  "enabled": {
                    "const": true
                  }
                },
                "required": [
                  "enabled"
                ]
              }
            }
          },
          {
            "properties": {
              "gateway": {
                "properties": {
                  "ingress": {
                    "properties": {
                      "enabled": {
                        "const": true
                      }
                    },
                    "required": [
                      "enabled"
                    ]
                  }
                },
                "required": [
                  "ingress"
                ]
              }
            }
          }
        ]
      },
      "then": {
        "if": {
          "properties": {
            "gateway": {
              "properties": {
                "allowInsecureHTTP": {
                  "const": true
                }
              },
              "required": [
                "allowInsecureHTTP"
              ]
            }
          }
        },
        "then": {
          "properties": {
            "gateway": {
              "properties": {
                "tls": {
                  "properties": {
                    "enabled": {
                      "const": false
                    }
                  }
                }
              }
            }
          }
        },
        "else": {
          "properties": {
            "gateway": {
              "properties": {
                "hostname": {
                  "minLength": 1
                },
                "tls": {
                  "properties": {
                    "enabled": {
                      "const": true
                    },
                    "secretName": {
                      "minLength": 1
                    }
                  }
                },
                "authentication": {
                  "properties": {
                    "proxyService": {
                      "properties": {
                        "name": {
                          "minLength": 1
                        }
                      }
                    }
                  }
                }
              }
            },
            "server": {
              "properties": {
                "cors": {
                  "properties": {
                    "allowedOrigins": {
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "pattern": "^https://[A-Za-z0-9](?:[-A-Za-z0-9.]*[A-Za-z0-9])?(?::[0-9]{1,5})?$"
                      },
                      "not": {
                        "contains": {
                          "const": "*"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "not": {
          "anyOf": [
            {
              "properties": {
                "gateway": {
                  "properties": {
                    "enabled": {
                      "const": true
                    }
                  },
                  "required": [
                    "enabled"
                  ]
                }
              }
            },
            {
              "properties": {
                "gateway": {
                  "properties": {
                    "ingress": {
                      "properties": {
                        "enabled": {
                          "const": true
                        }
                      },
                      "required": [
                        "enabled"
                      ]
                    }
                  },
                  "required": [
                    "ingress"
                  ]
                }
              }
            }
          ]
        }
      },
      "then": {
        "properties": {
          "gateway": {
            "properties": {
              "allowInsecureHTTP": {
                "const": false
              }
            }
          }
        }
      }
    }
  ]
}
