{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Europe/Istanbul",
  "labels": [
    "dependencies"
  ],
  "dependencyDashboard": true,
  "platformAutomerge": false,
  "prConcurrentLimit": 5,
  "packageRules": [
    {
      "description": "Delegate low-risk dependency merging to Mergify.",
      "matchUpdateTypes": [
        "patch",
        "digest",
        "pin"
      ],
      "automerge": false,
      "addLabels": [
        "automerge:enabled",
        "risk:low"
      ]
    },
    {
      "description": "Automerge safe non-major dependency updates after CI passes",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": false,
      "addLabels": [
        "automerge:enabled"
      ]
    },
    {
      "description": "Require manual review for major dependency updates",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    }
  ],
  "automerge": false,
  "automergeType": "pr",
  "osvVulnerabilityAlerts": false,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "dependencies",
      "security",
      "risk:high",
      "requires-review"
    ],
    "prCreation": "immediate",
    "vulnerabilityFixStrategy": "highest"
  }
}
